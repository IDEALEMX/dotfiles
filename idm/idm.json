{
    "dotfile-path" : "~/dotfiles/",
    "run-pre-gpush" : "~/dotfiles/scripts/encrypt-personal",

    "paths" : {
        "~/.config/" : {
            "fastfetch" : {},
            "idm" : {},
            "kitty" : {},
            "mpd" : {},
            "nushell" : { "alias" : "nu" },
            "nvim" : {},
            "mako" : {},
            "rmpc" : {},
            "rofi" : {},
            "cava" : {},
            "zsh" : {},
            "mango" : {},
            "waybar" : {},
        },

        "~/" : {
            "scripts" : {},
            "personal/notebook" : {
                "as" : "notebook",
                "alias" : "notebook"
            },

            "personal/org" : {
                "as" : "org",
                "alias" : "org"
            },

            ".zshenv" : {}
        }
    }
}
