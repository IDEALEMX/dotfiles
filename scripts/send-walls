#!/bin/nu

let remote = "u0_a395@192.168.100.32"
let port = 8022
let remote_dir = "~/storage/pictures/"

let ssh_songs = ssh -p $port $remote 'ls ~/storage/pictures/' 
    | lines

let diff = ls ~/walls/
    | where type == file
    | get name
    | each {|el| $el | path basename}
    | where {|el| not ($el in $ssh_songs)}
    | each {|base| $"($env.HOME)/walls/($base)"}

if not ($diff | is-empty) {
    scp -P $port ...$diff $"($remote):($remote_dir)"
}
