#!/bin/nu

let pick = [
  "pick-wallpaper"
  "get-music"
  "clipboard-history"
  "logout-menu"
  "toggle-cava"
] | to txt | rofi -dmenu -x11 -normal-window -config ~/dotfiles/rofi/gmenu.rasi

match $pick {
  "pick-wallpaper" => ~/scripts/wals
  "logout-menu" => ~/scripts/power
  "get-music" => ~/scripts/ytd
  "clipboard-history" => {cliphist list | rofi -dmenu -x11 -normal-window -config ~/dotfiles/rofi/gmenu.rasi | cliphist decode | wl-copy}
  "toggle-cava" => {~/dotfiles/scripts/toggle-class cava-overlay}
}

