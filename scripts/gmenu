#!/bin/nu

let pick = [
  "pick-wallpaper"
  "get-music"
  "clipboard-history"
  "logout-menu"
  "toggle-cava"
  "toggle-cbonsai"
] | to txt | fuzzel --dmenu

match $pick {
  "pick-wallpaper" => ~/scripts/wals
  "logout-menu" => ~/scripts/power
  "get-music" => ~/scripts/ytd
  "clipboard-history" => {cliphist list | fuzzel --dmenu | cliphist decode | wl-copy}
  "toggle-cava" => {~/dotfiles/scripts/toggle-class cava-overlay}
  "toggle-cbonsai" => {~/dotfiles/scripts/toggle-class cbonsai-overlay}
}

