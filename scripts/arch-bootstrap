#!/bin/nu

# The following script is meant ot bootstrap my system into an arch distro, may
# create one if I ever distro hop lol

# ===UTILS===

def ensure_installed [pkg_name] {
  if (pacman -Q $pkg_name | is-empty) {
    sudo pacman -S $pkg_name
  }
}

# Begin by updating system
sudo pacman -Syu

# Generate dotfiles
if not ("~/dotfiles" | path exists) {
  git clone "https://github.com/IDEALEMX/dotfiles" "~/dotfiles/"
}

mkdir ~/git-clones/
if not ("~/git-clones/idm/" | path exists) {
  git clone "https://github.com/IDEALEMX/idm" "~/git-clones/idm/"
  sudo link "~/git-clones/idm/idm" "/bin/idm"
}

# For encryption
ensure_installed "age"

# Sync configs
idm sync

# General applications
ensure_installed "cava"
ensure_installed "fastfetch"
ensure_installed "hyprland"
  # Dependencies
  ensure_installed "awww"
  ensure_installed "wl-clipboard"
  ensure_installed "cliphist"

ensure_installed "kitty"
  # Dependencies
  ensure_installed "ttf-jetbrains-mono-nerd"
  ensure_installed "ttf-jetbrains-mono"

ensure_installed "mako"
ensure_installed "mpd"
  systemctl --user enable mpd.service

ensure_installed "nvim"
  # Dependencies
  ensure_installed "yarn"
  ensure_installed "fzf"

ensure_installed "bat"
ensure_installed "rmpc"
ensure_installed "rofi"
ensure_installed "waybar"
  # Configure
  ~/dotfiles/waybar/install

ensure_installed "firefox"
ensure_installed "zsh"
  mkdir ~/.local/state/zsh
  mkdir ~/.cache/zsh
  ensure_installed "zoxide"
  ensure_installed "fd"
  ensure_installed "eza"

ensure_installed "cowsay"

# Wal
print "Wal must be installed manualy [WIP]"
  # Dependencies
  ensure_installed "imagemagick"
  ensure_installed "python-pipx"
  pipx install pywalfox
  pywalfox install

ensure_installed "zsh"

ensure_installed "man"

ensure_installed "yt-dlp"
