#!/usr/bin/env bash
set -euo pipefail

img="$(find ~/walls -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o \
       -iname '*.png' -o -iname '*.webp' \) \
    -print -quit)"

[[ -n "$img" ]] || {
    echo "No image found in ~/walls"
    exit 1
}

tmp="${XDG_RUNTIME_DIR:-/tmp}/ueberzugpp-test-$$"
mkdir -p "$tmp"

ueberzugpp layer \
    -o wayland \
    --no-stdin \
    --pid-file "$tmp/pid" &

pid=$!
trap 'kill "$pid" 2>/dev/null || true; rm -rf "$tmp"' EXIT

for _ in {1..50}; do
    [[ -s "$tmp/pid" ]] && break
    sleep 0.1
done

layer_pid="$(cat "$tmp/pid")"
socket="/tmp/ueberzugpp-${layer_pid}.socket"

for _ in {1..30}; do
    [[ -S "$socket" ]] && break
    sleep 0.1
done

ueberzugpp cmd -s "$socket" -a add \
    -i preview -x 2 -y 2 \
    --max-width 40 --max-height 15 -f "$img"

echo "Image sent. Press Enter to exit."
read -r
