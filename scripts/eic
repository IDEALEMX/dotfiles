#!/bin/nu
$env.config_file = "~/.config/eic/eic.json" | path expand
$env.obj = open $env.config_file
$env.port_path = $"($env.obj.port-directory | path expand)/"

# E.I.C. Export Import Dotfile
# A utility for managing and updating your dotfiles as needed!
def main [
  arg1, 
  # _
  # export: move dotfile from local to port
  # import: move dotfile from port to local
  arg2?: string,
  ...args: string
] {
  mut trace = []

  match $arg1 {
    "export" => {

      if ($arg2 == null) {
        error make { msg: "Dotfile name required, try eic --help" }
        return
      }

      if $arg2 == "all" {
        $trace = $trace ++ ($env.obj.dotfiles 
        | columns 
        | each { |el| export_dotfile $el } 
        | flatten)
      } else {
        $trace = $trace ++ (export_dotfile $arg2)
        $trace = $trace ++ ($args
          | each {|el| export_dotfile $el }
          | flatten)
      }
    },

    "import" => {
      if ($arg2 == null) {
        error make { msg: "Dotfile name required, try eic --help" }
        return
      }

      if $arg2 == "all" {
        $trace = $trace ++ ($env.obj.dotfiles 
        | columns 
        | each { |el| import_dotfile $el } 
        | flatten)
      } else {
        $trace = $trace ++ (import_dotfile $arg2)
        $trace = $trace ++ ($args
          | each {|el| import_dotfile $el }
          | flatten)
      }
    },

    "push" => {
      mut branch = "main"
      if $arg2 != null {
        $branch = $arg2 
      }

      git -C $env.port_path add -A
      git -C $env.port_path commit -m $"\"(random uuid)\""
      git -C $env.port_path push origin $branch

      $trace = $trace ++ [
        "GIT PUSH",
        $"\tbranch:  ($branch)"
      ]
    }

    _ => {
      error make { msg: "Unknown argument, try eic --help" }
      return
    },
  }

  print "/------------/TRACE/------------/"
  $trace | each { |el| print $el } | ignore
}

def export_dotfile [name] {
  mut trace = []

  if not ($name in ($env.obj.dotfiles | columns)) {
    error make { msg: "Dotfile name not found, try eic --help or eic status" }
    return
  }

  let dotfile_parent_path = $"($env.obj.dotfiles | get $name | path expand)/"
  let dotfile_path = $"($dotfile_parent_path)($name)/"

  try {
    rm -r $"($env.port_path)($name)/"
    $trace = $trace ++ [
      "REMOVE", 
      $"\ttarget: ($env.port_path)($name)/"
    ]
  }

  try {
    cp -r ($dotfile_path) ($env.port_path)
    $trace = $trace ++ [
      $"COPY",
      $"\tfrom:   ($dotfile_path)",
      $"\tto:     ($env.port_path)"
    ]
  }

  return $trace
}

def import_dotfile [name] {
  mut trace = []

  if not ($name in ($env.obj.dotfiles | columns)) {
    error make { msg: "Dotfile name not found, try eic --help or eic status" }
    return
  }

  let dotfile_parent_path = $"($env.obj.dotfiles | get $name | path expand)/"
  let dotfile_path = $"($dotfile_parent_path)($name)/"

  try {
    rm -r $dotfile_path
    $trace = $trace ++ [
      "REMOVE", 
      $"\ttarget: ($dotfile_path)"
    ]
  }

  try {
    cp -r $"($env.port_path)($name)/" ($dotfile_parent_path)
    $trace = $trace ++ [
      $"COPY",
      $"\tfrom:   ($env.port_path)($name)/",
      $"\tto:     ($dotfile_parent_path)"
    ]
  }

  return $trace
}
