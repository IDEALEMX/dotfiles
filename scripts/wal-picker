#!/bin/sh

find ~/walls/ -type f \
  \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) |
while IFS= read -r file; do
    printf '%s\0icon\x1fthumbnail://%s\n' \
        "$(basename "$file")" "$file"
done |
rofi -dmenu -normal-window -x11 -config ~/dotfiles/rofi/wallpapers.rasi -theme-str 'entry { placeholder: "Input wallpaper"; }'


